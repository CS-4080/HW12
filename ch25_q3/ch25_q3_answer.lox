fun Vector(x, y) {
  fun getX() { return x; }
  fun getY() { return y; }

  fun add(other) {
    return Vector(x + other("getX")(),
                  y + other("getY")());
  }

  fun dispatch(method) {
    if (method == "getX") return getX;
    if (method == "getY") return getY;
    if (method == "add") return add;
  }

  return dispatch;
}

// usage
var v1 = Vector(1, 2);
var v2 = Vector(3, 4);

var v3 = v1("add")(v2);

print v3("getX")(); // 4
print v3("getY")(); // 6